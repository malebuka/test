from safetensors import safe_open

ORIGINAL = "/path/to/original/model.safetensors"
MERGED = "/path/to/my-merged/model.safetensors"


def get_structure(path):
    result = {}

    with safe_open(path, framework="pt", device="cpu") as f:
        for key in f.keys():
            tensor_slice = f.get_slice(key)
            result[key] = tuple(tensor_slice.get_shape())

    return result


original = get_structure(ORIGINAL)
merged = get_structure(MERGED)

original_keys = set(original)
merged_keys = set(merged)

missing = sorted(original_keys - merged_keys)
extra = sorted(merged_keys - original_keys)

different_shapes = sorted(
    key
    for key in original_keys & merged_keys
    if original[key] != merged[key]
)

print("Количество тензоров:")
print("  original:", len(original))
print("  merged:  ", len(merged))

print("\nОтсутствуют в merged:")
if missing:
    for key in missing:
        print(f"- {key} {original[key]}")
else:
    print("Нет")

print("\nЛишние в merged:")
if extra:
    for key in extra:
        print(f"+ {key} {merged[key]}")
else:
    print("Нет")

print("\nРазличаются размеры:")
if different_shapes:
    for key in different_shapes:
        print(f"{key}: original={original[key]}, merged={merged[key]}")
else:
    print("Нет")

print("\nОставшиеся LoRA-ключи:")
lora_keys = [
    key for key in merged
    if "lora_" in key.lower() or "adapter" in key.lower()
]

if lora_keys:
    print(*lora_keys, sep="\n")
else:
    print("Нет")
