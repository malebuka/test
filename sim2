# Функция расчитывает текущую ценность каждой комбинации agentXclient для конкретного часа
# q(a,i,t) = p(i,t)*e(a,i)
# пример -> клиент:p(response в 10:00) = 0.2, агент: efficiency=0.50 -> P(success) = 0.2*0.6=0.12
# другой агент: efficienty=0.65 -> P(success) = 0.2*0.65=0.15
# следовательно второй агент выгоднее
def score_matrix_for_hour(
    p_response: np.ndarray,
    agent_eff: np.ndarray,
    hour_idx: int,
    clients: np.ndarray,
) -> np.ndarray:
    """
    Matrix [agent, client] of expected success probabilities for one hour.
    """
    return agent_eff[:, clients] * p_response[clients, hour_idx][None, :]

# решает, как распределить доступных клиентов по оставшимся часовым слотам.
# всего 16 слотов, в каждый час по 4 агента
def optimize_slots(
    p_response: np.ndarray,
    agent_eff: np.ndarray,
    clients: Iterable[int],
    start_hour_idx: int,
) -> List[Assignment]:
    """
    Solve maximum-weight assignment over all slots from start_hour_idx to end.

    Rows = (hour, agent) slots.
    Columns = eligible clients.
    linear_sum_assignment minimizes, so we pass negative expected value.
    """
    clients = np.array(sorted(clients), dtype=int)

    # создание списка слотов, для полного дня получится [(0, 0), (0, 1), (0, 2), (0, 3), ... , (3, 0), (3, 1), (3, 2), (3, 3)]
    slots: List[Tuple[int, int]] = [
        (hour_idx, agent)
        for hour_idx in range(start_hour_idx, N_HOURS)
        for agent in range(N_AGENTS)
    ]

    # матрица weights, получаем таблицу slotXclient, каждая ячейка P(response)*agent_efficiency
    weights = np.zeros((len(slots), len(clients)), dtype=float)

    # заполнение weights, например: строка 11:00, agent 3 содержит ожидаемую успешность этого оператора для каждого еще доступного клиента
    for row, (hour_idx, agent) in enumerate(slots):
        weights[row, :] = (
            p_response[clients, hour_idx] * agent_eff[agent, clients]
        )
    
    # оптимизация
    # дано: 16 слотов, 20 клиентов, алгоритм выберет 16 клиентов из 20, каждому ровно один слот, каждый слот получит одного клиента
    # так, чтобы sum(q(i, a, t)) была максимально возможной
    row_idx, col_idx = linear_sum_assignment(-weights)

    return [
        Assignment(
            hour_idx=slots[row][0],
            agent=slots[row][1],
            client=int(clients[col]),
        )
        for row, col in zip(row_idx, col_idx)
    ]

# Каждая колонка client может быть выбрана максимум один раз, поэтому client 3 не может одновременно получить 9:00 agent 1 и 12:00 agent 4.

# результат будет примерно: [Assigment(0, 0, 15), Assigment(0, 1, 7), Assigment(0, 2, 12), Assigment(0, 3, 4), ...] - расписание дня
