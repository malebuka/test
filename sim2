def plot_daily_distribution(
    daily_df: pd.DataFrame,
    output_path: Path,
) -> None:
    plt.figure(figsize=(10, 6))

    max_result = int(daily_df["collected_clients"].max())
    
    x = np.arange(0, max_result + 1)


    for policy in POLICY_ORDER:
        values = daily_df.loc[
            daily_df["policy"] == policy,
            "collected_clients",
        ]
        distribution = (values.value_counts().reindex(x, fill_value=0).sort_index())
        distribution_pct = (distribution/len(values)*100)
        
        plt.plot(x, distribution_pct, marker="o", label=policy)

    plt.xlabel("Количество успешных взысканий за день")
    plt.ylabel("Доля симуляций, %")
    plt.title("Распределение дневного результата")
    plt.xticks(x)
    plt.legend()
    plt.tight_layout()
    plt.savefig(output_path, dpi=160)
    plt.close()

