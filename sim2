def make_summary(daily_df: pd.DataFrame) -> pd.DataFrame:
    summary = (
        daily_df
        .groupby("policy")
        .agg(
            mean_collected=("collected_clients", "mean"),
            median_collected=("collected_clients", "median"),
            
            p_zero=("collected_clients", lambda x: (x==0).mean()),
            p_1plus=("collected_clients", lambda x: (x>=1).mean()),
            p_2plus=("collected_clients", lambda x: (x>=2).mean()),
            p_3plus=("collected_clients", lambda x: (x>=3).mean()),
            
            mean_amount=("collected_amount", "mean"),
            mean_expected=("expected_collected_clients", "mean"),
            
            )
            .reindex(POLICY_ORDER)
            .reset_index()
            
    )


    for col in ['p_zero', 'p_1plus', 'p_2plus', 'p_3plus']:
        summary[col] = summary[col]*100
        
    return summary

def make_hourly_summary(hourly_df: pd.DataFrame) -> pd.DataFrame:
    return (
        hourly_df
        .groupby(["policy", "hour"])
        .agg(
            mean_actual_clients=("collected_clients", "mean"),
            mean_expected_clients=("expected_collected_clients", "mean"),
            mean_collected_amount=("collected_amount", "mean"),
        )
        .reset_index()
    )


